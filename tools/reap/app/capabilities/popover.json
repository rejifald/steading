{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popover",
  "description": "The popover's commands and the one event it listens to; nothing else.",
  "windows": ["popover"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-report",
    "allow-refresh",
    "allow-toggle-pause",
    "allow-pick-folder",
    "allow-add",
    "allow-keep",
    "allow-unkeep",
    "allow-remove-now",
    "allow-stop-process",
    "allow-find-clones",
    "allow-add-suggestion",
    "allow-skip-clone",
    "allow-unskip-clone",
    "allow-add-scan-root",
    "allow-remove-scan-root",
    "allow-open-in-finder",
    "allow-hide",
    "allow-quit"
  ]
}
