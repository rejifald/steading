{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popover",
  "description": "The popover's commands and the one event it listens to; nothing else.",
  "windows": ["popover"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-report",
    "allow-sync",
    "allow-toggle-pause",
    "allow-pick-folder",
    "allow-branch-of",
    "allow-add",
    "allow-set-interval",
    "allow-remove",
    "allow-open-in-finder",
    "allow-hide",
    "allow-quit"
  ]
}
