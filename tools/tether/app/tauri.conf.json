{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tether",
  "version": "0.1.0",
  "identifier": "io.github.rejifald.tether",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": {
      "script": "npm --prefix ../../.. ci && npm --prefix ui run build",
      "cwd": "."
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "tether",
        "url": "index.html",
        "width": 360,
        "height": 480,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
